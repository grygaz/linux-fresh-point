#!/bin/sh
set -eu
app_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ ! -x /usr/bin/python3 ]; then
    echo 'Linux fresh point: Python 3 is required at /usr/bin/python3.' >&2
    exit 1
fi
/usr/bin/python3 -I "$app_dir/dependency_check.py"
if [ -f "$app_dir/portable.mode" ]; then
    exec /usr/bin/python3 -I "$app_dir/portable.py" "$@"
fi
exec /usr/bin/python3 -I "$app_dir/app.py" "$@"
